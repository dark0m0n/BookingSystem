{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "RedisCache": {
    "OperationTimeout": "00:00:00.250",
    "ConnectionTimeout": "00:00:00.500",
    "CommandTimeout": "00:00:00.500"
  },
  "SeatAvailabilityCache": {
    "Enabled": true,
    "MinimumSeatCount": 64,
    "Lifetime": "00:00:05"
  },
  "Jwt": {
    "Issuer": "TicketBooking",
    "Audience": "TicketBooking.Api",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 7
  },
  "HoldExpiry": {
    "BatchSize": 100,
    "PollInterval": "00:00:05"
  },
  "BookingTiming": {
    "HoldDuration": "00:10:00",
    "PaymentCompletionWindow": "00:15:00",
    "CancellationLeadTime": "01:00:00"
  }
}
